<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>¡La Súper Fiesta de Emilio! 🕷️</title>
<link href="https://fonts.googleapis.com/css2?family=Bangers&family=Nunito:wght@700;900&display=swap" rel="stylesheet">
<style>
  :root {
    --red: #E31836;
    --blue: #1565C0;
    --yellow: #FFD600;
    --pink: #E91E8C;
    --dark: #0a0a1a;
    --web: #29B6F6;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: var(--dark); font-family: 'Nunito', sans-serif; min-height: 100vh; overflow-x: hidden; position: relative; }
  .bg-canvas { position: fixed; inset: 0; z-index: 0; background: radial-gradient(ellipse at 20% 30%, #1a0033 0%, #0a0a1a 60%), radial-gradient(ellipse at 80% 70%, #1a0020 0%, transparent 60%); }
  .web-svg { position: fixed; opacity: 0.13; animation: webPulse 4s ease-in-out infinite alternate; }
  .web-svg.tl { top: -60px; left: -60px; width: 320px; color: var(--web); }
  .web-svg.br { bottom: -60px; right: -60px; width: 280px; color: var(--pink); transform: rotate(180deg); }
  .web-svg.tr { top: -40px; right: -40px; width: 220px; color: var(--yellow); transform: rotate(90deg); animation-delay: 1.5s; }
  @keyframes webPulse { from { opacity: 0.10; transform: scale(1) rotate(0deg); } to { opacity: 0.20; transform: scale(1.05) rotate(3deg); } }
  .spider { position: fixed; font-size: 1.8rem; animation: dangle linear infinite; opacity: 0.7; z-index: 1; }
  @keyframes dangle { 0% { transform: translateY(-100px) rotate(-10deg); opacity: 0; } 10% { opacity: 0.7; } 90% { opacity: 0.7; } 100% { transform: translateY(110vh) rotate(10deg); opacity: 0; } }
  .sp1 { left: 8%; animation-duration: 9s; animation-delay: 0s; }
  .sp2 { left: 25%; animation-duration: 12s; animation-delay: 3s; }
  .sp3 { left: 60%; animation-duration: 10s; animation-delay: 1.5s; }
  .sp4 { left: 82%; animation-duration: 14s; animation-delay: 5s; }
  .sp5 { left: 45%; animation-duration: 11s; animation-delay: 7s; }
  .wrap { position: relative; z-index: 10; max-width: 520px; margin: 0 auto; padding: 24px 16px 48px; }
  .hero { text-align: center; margin-bottom: 28px; animation: heroIn 0.8s cubic-bezier(.22,1,.36,1) both; }
  @keyframes heroIn { from { opacity: 0; transform: translateY(-40px) scale(0.9); } to { opacity: 1; transform: translateY(0) scale(1); } }
  .hero-eyebrow { font-family: 'Bangers', cursive; font-size: 1.1rem; letter-spacing: 4px; color: var(--yellow); text-transform: uppercase; margin-bottom: 6px; text-shadow: 0 0 12px rgba(255,214,0,0.5); }
  .hero-title { font-family: 'Bangers', cursive; font-size: clamp(3.2rem, 14vw, 5.5rem); line-height: 0.9; background: linear-gradient(135deg, var(--red) 0%, #ff6b6b 40%, var(--yellow) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; filter: drop-shadow(0 4px 12px rgba(227,24,54,0.5)); letter-spacing: 2px; }
  .hero-subtitle { font-family: 'Bangers', cursive; font-size: clamp(1.3rem, 5vw, 2rem); color: var(--web); letter-spacing: 3px; margin-top: 4px; text-shadow: 0 0 16px rgba(41,182,246,0.6); }
  .age-badge { display: inline-block; margin: 14px auto 0; background: var(--yellow); color: var(--dark); font-family: 'Bangers', cursive; font-size: 3.2rem; width: 72px; height: 72px; border-radius: 50%; line-height: 72px; box-shadow: 0 0 0 5px var(--red), 0 8px 24px rgba(227,24,54,0.5); animation: spin3d 6s ease-in-out infinite; }
  @keyframes spin3d { 0%,100% { transform: rotateY(0deg); } 50% { transform: rotateY(360deg); } }
  .info-card { background: rgba(255,255,255,0.04); border: 2px solid rgba(41,182,246,0.3); border-radius: 20px; padding: 22px 20px; margin-bottom: 24px; animation: cardIn 0.8s 0.2s cubic-bezier(.22,1,.36,1) both; backdrop-filter: blur(8px); position: relative; overflow: hidden; }
  .info-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--red), var(--web), var(--yellow)); }
  @keyframes cardIn { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  .info-row { display: flex; align-items: center; gap: 14px; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .info-row:last-child { border-bottom: none; }
  .info-icon { font-size: 1.8rem; min-width: 42px; text-align: center; }
  .info-label { font-size: 0.7rem; color: var(--web); font-weight: 900; letter-spacing: 2px; text-transform: uppercase; }
  .info-value { font-size: 1.05rem; color: #fff; font-weight: 700; line-height: 1.3; }
  .countdown-wrap { text-align: center; margin-bottom: 28px; animation: cardIn 0.8s 0.4s cubic-bezier(.22,1,.36,1) both; }
  .countdown-label { font-family: 'Bangers', cursive; font-size: 1.1rem; letter-spacing: 3px; color: var(--pink); margin-bottom: 12px; }
  .countdown-boxes { display: flex; justify-content: center; gap: 10px; }
  .cd-box { background: linear-gradient(135deg, var(--red) 0%, #9c0020 100%); border-radius: 12px; padding: 10px 14px; min-width: 64px; }
  .cd-num { font-family: 'Bangers', cursive; font-size: 2.4rem; color: #fff; line-height: 1; display: block; }
  .cd-unit { font-size: 0.65rem; color: rgba(255,255,255,0.7); letter-spacing: 1px; text-transform: uppercase; font-weight: 700; }
  .form-section { animation: cardIn 0.8s 0.5s cubic-bezier(.22,1,.36,1) both; }
  .form-title { font-family: 'Bangers', cursive; font-size: 1.8rem; color: var(--yellow); letter-spacing: 2px; margin-bottom: 16px; text-align: center; }
  .field { margin-bottom: 14px; }
  .field label { display: block; font-size: 0.72rem; font-weight: 900; letter-spacing: 2px; color: var(--web); text-transform: uppercase; margin-bottom: 6px; }
  .field input, .field select { width: 100%; padding: 13px 16px; background: rgba(255,255,255,0.06); border: 2px solid rgba(41,182,246,0.25); border-radius: 12px; color: #fff; font-family: 'Nunito', sans-serif; font-size: 1rem; font-weight: 700; transition: border-color 0.2s; outline: none; appearance: none; }
  .field input::placeholder { color: rgba(255,255,255,0.3); }
  .field input:focus, .field select:focus { border-color: var(--web); background: rgba(41,182,246,0.08); }
  .field select option { background: #1a1a2e; color: #fff; }
  .guests-row { display: flex; gap: 10px; }
  .guests-row .field { flex: 1; }
  .btn-confirm { width: 100%; margin-top: 6px; padding: 17px; background: linear-gradient(135deg, var(--red) 0%, #c9002e 100%); border: none; border-radius: 16px; color: #fff; font-family: 'Bangers', cursive; font-size: 1.5rem; letter-spacing: 2px; cursor: pointer; box-shadow: 0 6px 24px rgba(227,24,54,0.5); transition: transform 0.15s; }
  .btn-confirm:hover { transform: translateY(-2px); }
  .success { display: none; text-align: center; padding: 40px 20px; animation: popIn 0.5s cubic-bezier(.22,1,.36,1) both; }
  @keyframes popIn { from { opacity: 0; transform: scale(0.7); } to { opacity: 1; transform: scale(1); } }
  .success-icon { font-size: 5rem; margin-bottom: 16px; }
  .success-title { font-family: 'Bangers', cursive; font-size: 2.8rem; color: var(--yellow); letter-spacing: 2px; margin-bottom: 10px; }
  .success-msg { color: rgba(255,255,255,0.8); font-size: 1.05rem; line-height: 1.5; }
  .success-msg strong { color: var(--web); }
  .footer { text-align: center; margin-top: 36px; color: rgba(255,255,255,0.25); font-size: 0.75rem; }
</style>
</head>
<body>
<div class="bg-canvas"></div>
<svg class="web-svg tl" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="0" y1="0" x2="200" y2="0"/><line x1="0" y1="0" x2="200" y2="50"/><line x1="0" y1="0" x2="200" y2="100"/><line x1="0" y1="0" x2="200" y2="150"/><line x1="0" y1="0" x2="200" y2="200"/><line x1="0" y1="0" x2="100" y2="200"/><line x1="0" y1="0" x2="50" y2="200"/><line x1="0" y1="0" x2="0" y2="200"/><path d="M40,0 Q20,20 0,40"/><path d="M80,0 Q40,40 0,80"/><path d="M120,0 Q60,60 0,120"/><path d="M160,0 Q80,80 0,160"/><path d="M200,0 Q100,100 0,200"/></svg>
<svg class="web-svg br" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="0" y1="0" x2="200" y2="0"/><line x1="0" y1="0" x2="200" y2="50"/><line x1="0" y1="0" x2="200" y2="100"/><line x1="0" y1="0" x2="200" y2="150"/><line x1="0" y1="0" x2="200" y2="200"/><line x1="0" y1="0" x2="100" y2="200"/><path d="M80,0 Q40,40 0,80"/><path d="M160,0 Q80,80 0,160"/><path d="M200,0 Q100,100 0,200"/></svg>
<div class="spider sp1">🕷️</div>
<div class="spider sp2">🕸️</div>
<div class="spider sp3">🕷️</div>
<div class="spider sp4">🕸️</div>
<div class="spider sp5">🕷️</div>
<div class="wrap">
  <div class="hero">
    <div class="hero-eyebrow">¡La Súper Fiesta de</div>
    <div class="hero-title">EMILIO</div>
    <div class="hero-subtitle">🕷️ Spidey & Sus Amigos 🕷️</div>
    <div class="age-badge">4</div>
  </div>
  <div class="info-card">
    <div class="info-row"><div class="info-icon">📅</div><div><div class="info-label">Fecha</div><div class="info-value">Jueves 25 de Junio, 2026</div></div></div>
    <div class="info-row"><div class="info-icon">⏰</div><div><div class="info-label">Hora</div><div class="info-value">4:00 PM</div></div></div>
    <div class="info-row"><div class="info-icon">📍</div><div><div class="info-label">Lugar</div><div class="info-value">My Play Room<br><span style="font-size:0.85rem;color:rgba(255,255,255,0.5);font-weight:700;">¡Vamos a divertirnos!</span></div></div></div>
  </div>
  <div class="countdown-wrap">
    <div class="countdown-label">⚡ FALTAN ⚡</div>
    <div class="countdown-boxes">
      <div class="cd-box"><span class="cd-num" id="cd-days">--</span><span class="cd-unit">Días</span></div>
      <div class="cd-box" style="background:linear-gradient(135deg,#1565C0,#003c8f)"><span class="cd-num" id="cd-hours">--</span><span class="cd-unit">Horas</span></div>
      <div class="cd-box" style="background:linear-gradient(135deg,#E91E8C,#880057)"><span class="cd-num" id="cd-mins">--</span><span class="cd-unit">Minutos</span></div>
    </div>
  </div>
  <div class="form-section" id="formSection">
    <div class="form-title">🕸️ ¡Confirma tu Asistencia! 🕸️</div>
    <div class="field"><label>Tu nombre completo</label><input type="text" id="nombre" placeholder="ej. María García" /></div>
    <div class="field"><label>Tu teléfono / WhatsApp (opcional)</label><input type="tel" id="telefono" placeholder="ej. 55 1234 5678" /></div>
    <div class="guests-row">
      <div class="field"><label>Adultos</label><select id="adultos"><option value="1">1 adulto</option><option value="2" selected>2 adultos</option><option value="3">3 adultos</option><option value="4">4 adultos</option><option value="5">5+ adultos</option></select></div>
      <div class="field"><label>Niños</label><select id="ninos"><option value="0">Sin niños</option><option value="1" selected>1 niño</option><option value="2">2 niños</option><option value="3">3 niños</option><option value="4">4 niños</option><option value="5">5+ niños</option></select></div>
    </div>
    <div class="field"><label>¿Asistirás?</label><select id="asistencia"><option value="si">✅ ¡Sí voy!</option><option value="no">❌ No podré ir</option><option value="quizas">🤔 Quizás...</option></select></div>
    <div class="field"><label>Mensaje para Emilio (opcional)</label><input type="text" id="mensaje" placeholder="ej. ¡Feliz cumpleaños campeón! 🕷️" /></div>
    <button class="btn-confirm" id="btnConfirmar" onclick="confirmar()">🕷️ ¡CONFIRMAR ASISTENCIA! 🕷️</button>
  </div>
  <div class="success" id="successSection">
    <div class="success-icon" id="successIcon">🕷️</div>
    <div class="success-title" id="successTitle">¡CONFIRMADO!</div>
    <div class="success-msg" id="successMsg"></div>
  </div>
  <div class="footer">Hecho con ❤️ para la súper fiesta de Emilio 🕸️</div>
</div>
<script>
function updateCountdown() {
  const party = new Date('2026-06-25T16:00:00');
  const now = new Date();
  const diff = party - now;
  if (diff <= 0) { document.getElementById('cd-days').textContent='🎉'; document.getElementById('cd-hours').textContent='🎉'; document.getElementById('cd-mins').textContent='🎉'; return; }
  document.getElementById('cd-days').textContent = Math.floor(diff/86400000);
  document.getElementById('cd-hours').textContent = Math.floor((diff%86400000)/3600000);
  document.getElementById('cd-mins').textContent = Math.floor((diff%3600000)/60000);
}
updateCountdown();
setInterval(updateCountdown, 30000);
async function confirmar() {
  const nombre = document.getElementById('nombre').value.trim();
  if (!nombre) { const i=document.getElementById('nombre'); i.focus(); i.style.borderColor='#E31836'; return; }
  const asistencia=document.getElementById('asistencia').value;
  const adultos=document.getElementById('adultos').value;
  const ninos=document.getElementById('ninos').value;
  const telefono=document.getElementById('telefono').value.trim();
  const mensaje=document.getElementById('mensaje').value.trim();
  const btn=document.getElementById('btnConfirmar');
  btn.textContent='⏳ Enviando...'; btn.disabled=true;
  try {
    const res=await fetch('https://formspree.io/f/mnjrgbqy',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({nombre,telefono:telefono||'—',asistencia:asistencia==='si'?'✅ SÍ VA':asistencia==='no'?'❌ NO VA':'🤔 QUIZÁS',adultos,ninos,mensaje:mensaje||'—'})});
    if(!res.ok) throw new Error();
  } catch(e) { btn.textContent='🕷️ ¡CONFIRMAR ASISTENCIA! 🕷️'; btn.disabled=false; alert('Hubo un problema. Intenta de nuevo.'); return; }
  document.getElementById('formSection').style.display='none';
  document.getElementById('successSection').style.display='block';
  if(asistencia==='si'){document.getElementById('successIcon').textContent='🎉🕷️🎉';document.getElementById('successTitle').textContent='¡HASTA LA FIESTA!';document.getElementById('successMsg').innerHTML=`¡Genial, <strong>${nombre}</strong>! 🕸️<br><br>Anotamos <strong>${adultos} adulto(s)</strong> y <strong>${ninos} niño(s)</strong>.<br><br>¡Nos vemos el 25 de Junio a las 4:00 PM en My Play Room! 🕷️${mensaje?`<br><br><em style="color:#FFD600">"${mensaje}"</em>`:''}`;}
  else if(asistencia==='no'){document.getElementById('successIcon').textContent='😢';document.getElementById('successTitle').textContent='¡NOS FALTARÁS!';document.getElementById('successMsg').innerHTML=`Lamentamos que no puedas ir, <strong>${nombre}</strong>. 😢<br><br>Emilio te enviará telarañas de cariño. 🕸️${mensaje?`<br><br><em style="color:#FFD600">"${mensaje}"</em>`:''}`;}
  else{document.getElementById('successIcon').textContent='🤔🕷️';document.getElementById('successTitle').textContent='¡AVÍSANOS PRONTO!';document.getElementById('successMsg').innerHTML=`Ok <strong>${nombre}</strong>, ¡esperamos que puedas venir! 🕷️`;}
}
</script>
</body>
</html>